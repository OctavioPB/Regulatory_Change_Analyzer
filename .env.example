# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rca_user:rca_pass@localhost:5432/regulatory_db
DATABASE_URL_SYNC=postgresql://rca_user:rca_pass@localhost:5432/regulatory_db

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── LLM (opcional, reservado para features futuras) ───────────────────────────
ANTHROPIC_API_KEY=
# Claude model used by chat (RAG) and addendum drafting
LLM_MODEL=claude-opus-5-5
# Local models instead of Claude (no API key, nothing leaves the machine):
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M      # or gemma4:26b-a4b-it-qat
# OLLAMA_URL=http://localhost:11434

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production
# Log every SQL statement (very verbose)
DB_ECHO=false
# Comma-separated allowed origins for the browser UI ("*" disables credentials)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── RBAC (vacío = dev mode, todas las requests como admin) ────────────────────
# Formato: JSON map {"api-key": "role"}
# Roles válidos: viewer | analyst | compliance_officer | admin
API_KEYS={}

# ── Task manager (opcional) ───────────────────────────────────────────────────
TASK_MANAGER=none
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=COMP
ASANA_ACCESS_TOKEN=
ASANA_PROJECT_GID=

# ── Rate limiting ─────────────────────────────────────────────────────────────
INGEST_RATE_LIMIT=10
