# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rca_user:rca_pass@localhost:5432/regulatory_db
DATABASE_URL_SYNC=postgresql://rca_user:rca_pass@localhost:5432/regulatory_db

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── LLM (opcional, reservado para features futuras) ───────────────────────────
ANTHROPIC_API_KEY=

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production

# ── RBAC (vacío = dev mode, todas las requests como admin) ────────────────────
# Formato: JSON map {"api-key": "role"}
# Roles válidos: viewer | analyst | compliance_officer | admin
API_KEYS={}

# ── Task manager (opcional) ───────────────────────────────────────────────────
TASK_MANAGER=none
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=COMP
ASANA_ACCESS_TOKEN=
ASANA_PROJECT_GID=

# ── Rate limiting ─────────────────────────────────────────────────────────────
INGEST_RATE_LIMIT=10
